# Required: Discord bot token. Keep this secret.
token=

# Bot configuration
# Comma-separated list of Discord user IDs allowed to use owner commands
ownerIDS=
# Enable built-in promotional status advertisements (default: false)
AD_ENABLED=false

# Optional service API keys.
memer_api=
fnbr=
fortnitetracker=
BRAINSHOP_BID=
BRAINSHOP_KEY=

# Optional Spotify integration credentials (for Lavalink music player).
clientSecret=
clientID=

# Optional Twitch social-log credentials.
twitch_clientID=
twitch_secret=

# Optional Twitter social-log credentials.
consumer_key=
consumer_secret=
access_token=
access_token_secret=
