{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check environment variable usage",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require('node:fs'),path=require('node:path');const terms=['process.env.','dotenv.config'];function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){if(['node_modules','.git'].includes(e.name))continue;const f=path.join(d,e.name);if(e.isDirectory())walk(f);else if(e.name.endsWith('.js')){const s=fs.readFileSync(f,'utf8');for(const line of s.split(/\\r?\\n/))if(terms.some(t=>line.includes(t)))console.log(f+': '+line.trim());}}}walk('.');"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List environment variable references",
			"type": "shell",
			"command": "grep",
			"args": [
